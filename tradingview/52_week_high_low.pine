//@version=6
indicator("52-Week High / Low", shorttitle = "52W H/L", overlay = true, max_bars_back = 5000, max_labels_count = 500)

// ───────────────────────── Inputs ─────────────────────────
grpLb = "Lookback"
MODE_CAL  = "Calendar (weeks)"
MODE_BARS = "Bars"
mode          = input.string(MODE_CAL, "Lookback type", options = [MODE_CAL, MODE_BARS], group = grpLb, display = display.none,
                 tooltip = "Calendar: a span of time (52 weeks = one year), however many bars that is.\nBars: a fixed number of bars on the selected timeframe, e.g. 252 bars on D = 252-day high/low.")
lookbackWeeks = input.int(52,  "Weeks (calendar)", minval = 1, maxval = 520,  group = grpLb, display = display.none)
lookbackBars  = input.int(252, "Bars (bars mode)", minval = 2, maxval = 4999, group = grpLb, display = display.none)

TF_AUTO   = "Auto"
TF_CHART  = "Chart"
TF_CUSTOM = "Custom"
tfSource = input.string(TF_AUTO, "Timeframe", options = [TF_AUTO, TF_CHART, TF_CUSTOM], group = grpLb, display = display.none,
             tooltip = "Auto: daily bars on intraday charts, the chart's own bars otherwise.\nChart: always the chart's timeframe.\nCustom: the timeframe below. It must be the same as or higher than the chart's.")
tfCustom = input.timeframe("D", "Custom timeframe", group = grpLb, display = display.none)

useWicks = input.bool(true, "Use wicks (high/low)", group = grpLb, display = display.none, tooltip = "Off = use closing prices instead of highs/lows.")

grpStyle   = "Style"
hiColor    = input.color(color.new(color.teal, 0), "High line", group = grpStyle, display = display.none)
loColor    = input.color(color.new(color.red, 0),  "Low line",  group = grpStyle, display = display.none)
lineWidth  = input.int(1, "Line width", minval = 1, maxval = 4, group = grpStyle, display = display.none)
showLabels = input.bool(true, "Show price labels on last bar", group = grpStyle, display = display.none)
showMarks  = input.bool(true, "Mark new highs/lows",           group = grpStyle, display = display.none)
showTable  = input.bool(true, "Show distance table",           group = grpStyle, display = display.none)

// ───────────────────────── Setup ─────────────────────────
isCal      = mode == MODE_CAL
lookbackMs = lookbackWeeks * 7 * 24 * 60 * 60 * 1000
hiSrc      = useWicks ? high : close
loSrc      = useWicks ? low  : close

tf = switch tfSource
    TF_CHART  => timeframe.period
    TF_CUSTOM => tfCustom
    => timeframe.isintraday ? "D" : timeframe.period

tfSec    = timeframe.in_seconds(tf)
chartSec = timeframe.in_seconds(timeframe.period)
onChart  = tfSec == chartSec

if barstate.isfirst and tfSec < chartSec
    runtime.error("Lookback timeframe (" + tf + ") is lower than the chart timeframe. Pick a timeframe equal to or higher than the chart's.")

// ───────────────────────── Helpers ─────────────────────────
// Calendar mode: extremes of all PRIOR bars whose open time falls inside the window.
priorCalHL(series float h, series float l, int windowMs) =>
    float hh = na
    float ll = na
    int i = 1
    while i < 4999 and not na(time[i]) and time[i] > time - windowMs
        hh := na(hh) ? h[i] : math.max(hh, h[i])
        ll := na(ll) ? l[i] : math.min(ll, l[i])
        i += 1
    [hh, ll]

// Bars mode: extremes of the n bars BEFORE the current one.
priorBarsHL(series float h, series float l, simple int n) =>
    [ta.highest(h, n)[1], ta.lowest(l, n)[1]]

// Both helpers exclude the current bar, so with lookahead_on they never use
// unfinished higher-timeframe data and the lines don't repaint.

tfText(string t) =>
    float mins = str.tonumber(t)
    na(mins) ? t : mins % 60 == 0 ? str.tostring(mins / 60, "#") + "h" : str.tostring(mins, "#") + "m"

// ───────────────────────── Core ─────────────────────────
[chartBarsHi, chartBarsLo] = priorBarsHL(hiSrc, loSrc, lookbackBars - 1)

float priorHi = na
float priorLo = na

if onChart
    if isCal
        [ch, cl] = priorCalHL(hiSrc, loSrc, lookbackMs)
        priorHi := ch
        priorLo := cl
    else
        priorHi := chartBarsHi
        priorLo := chartBarsLo
else
    if isCal
        [sh, sl] = request.security(syminfo.tickerid, tf, priorCalHL(hiSrc, loSrc, lookbackMs), lookahead = barmerge.lookahead_on)
        priorHi := sh
        priorLo := sl
    else
        [sh, sl] = request.security(syminfo.tickerid, tf, priorBarsHL(hiSrc, loSrc, lookbackBars - 1), lookahead = barmerge.lookahead_on)
        priorHi := sh
        priorLo := sl

// The still-forming higher-timeframe bar is tracked live on the chart.
htfNew = timeframe.change(tf)
var float runHi = na
var float runLo = na
if htfNew or na(runHi)
    runHi := high
    runLo := low
else
    runHi := math.max(runHi, high)
    runLo := math.min(runLo, low)

// In close mode the forming bar's "close" is simply the current close.
curHi = onChart or not useWicks ? hiSrc : runHi
curLo = onChart or not useWicks ? loSrc : runLo

hiLvl = na(priorHi) ? curHi : math.max(priorHi, curHi)
loLvl = na(priorLo) ? curLo : math.min(priorLo, curLo)

// A new extreme is set when this bar pushes past the level that stood on the previous bar.
newHigh = not na(hiLvl[1]) and hiSrc > hiLvl[1]
newLow  = not na(loLvl[1]) and loSrc < loLvl[1]

lenTxt = isCal ? str.tostring(lookbackWeeks) + "W" : str.tostring(lookbackBars) + " × " + tfText(tf)

// ───────────────────────── Plots ─────────────────────────
plot(hiLvl, "Lookback High", hiColor, lineWidth, plot.style_stepline, linestyle = plot.linestyle_dotted)
plot(loLvl, "Lookback Low",  loColor, lineWidth, plot.style_stepline, linestyle = plot.linestyle_dotted)

plotshape(showMarks and newHigh, "New High", shape.triangledown, location.abovebar, hiColor, size = size.tiny, display = display.pane)
plotshape(showMarks and newLow,  "New Low",  shape.triangleup,   location.belowbar, loColor, size = size.tiny, display = display.pane)

// % move needed from the current price to reach a level (positive = up, negative = down).
pctTo(level) => (level - close) / close * 100

var label hiLbl = na
var label loLbl = na
if showLabels and barstate.islast
    label.delete(hiLbl)
    label.delete(loLbl)
    hiLbl := label.new(bar_index, hiLvl, str.format("{0} H {1}  (+{2,number,0.00}% to reach)", lenTxt, str.tostring(hiLvl, format.mintick), pctTo(hiLvl)),
                       style = label.style_label_left, color = color.new(hiColor, 80), textcolor = hiColor, size = size.small)
    loLbl := label.new(bar_index, loLvl, str.format("{0} L {1}  ({2,number,0.00}% to reach)", lenTxt, str.tostring(loLvl, format.mintick), pctTo(loLvl)),
                       style = label.style_label_left, color = color.new(loColor, 80), textcolor = loColor, size = size.small)

var table tbl = table.new(position.top_right, 2, 5, bgcolor = color.new(color.gray, 85), border_width = 1)
if showTable and barstate.islast
    rangePos = hiLvl == loLvl ? 100.0 : (close - loLvl) / (hiLvl - loLvl) * 100
    table.cell(tbl, 0, 0, lenTxt + " High",  text_color = hiColor, text_size = size.small)
    table.cell(tbl, 1, 0, str.tostring(hiLvl, format.mintick), text_color = hiColor, text_size = size.small)
    table.cell(tbl, 0, 1, lenTxt + " Low",   text_color = loColor, text_size = size.small)
    table.cell(tbl, 1, 1, str.tostring(loLvl, format.mintick), text_color = loColor, text_size = size.small)
    table.cell(tbl, 0, 2, "Upside to high",   text_size = size.small, text_color = hiColor)
    table.cell(tbl, 1, 2, "+" + str.tostring(pctTo(hiLvl), "0.00") + "%", text_size = size.small, text_color = hiColor)
    table.cell(tbl, 0, 3, "Downside to low",  text_size = size.small, text_color = loColor)
    table.cell(tbl, 1, 3, str.tostring(pctTo(loLvl), "0.00") + "%", text_size = size.small, text_color = loColor)
    table.cell(tbl, 0, 4, "Range position",   text_size = size.small, text_color = chart.fg_color)
    table.cell(tbl, 1, 4, str.tostring(rangePos, "0.0") + "%", text_size = size.small, text_color = chart.fg_color)

// ───────────────────────── Alerts ─────────────────────────
alertcondition(newHigh, "New lookback high", "{{ticker}} made a new lookback high at {{high}}")
alertcondition(newLow,  "New lookback low",  "{{ticker}} made a new lookback low at {{low}}")
