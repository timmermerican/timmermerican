# ── Required ──────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-api03-...

# ── Search backend ────────────────────────────────────────────────────────
# If TAVILY_API_KEY is set, Tavily is used automatically (preferred).
# If not set, DuckDuckGo is used with no key required.
# Tavily free tier: 1000 searches/month — sign up at tavily.com
TAVILY_API_KEY=tvly-...

# ── Model selection ───────────────────────────────────────────────────────
# Defaults to claude-haiku-4-5-20251001 for cost efficiency.
# Use claude-sonnet-5 for higher quality briefs.
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# ── Podcast extractor ─────────────────────────────────────────────────────
# Path to your existing podcast transcript extractor script.
# It will be called as: python <PODCAST_EXTRACTOR_PATH> <url>
# and should print the transcript text to stdout.
# PODCAST_EXTRACTOR_PATH=/path/to/your/extractor.py
